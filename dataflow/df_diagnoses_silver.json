				"source1 derive(diagnosis_id = toInteger(trim(diagnosis_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          icd_code = iif(     isNull(icd_code) || trim(icd_code) == '',     toString(null()),     replace(         replace(             replace(                 replace(                     replace(                         replace(                             upper(                                 regexReplace(                                     replace(trim(icd_code), '-', '.'),                                     '\\\\s*,\\\\s*',                                     ', '                                 )                             ),                             'M545', 'M54.5'                         ),                         'E119', 'E11.9'                     ),                     'F329', 'F32.9'                 ),                 'K219', 'K21.9'             ),             'C50911', 'C50.911'         ),         'N390', 'N39.0'     ) ),",
				"          diagnosis_description = iif(     isNull(diagnosis_description) || trim(diagnosis_description) == '',     toString(null()),     trim(diagnosis_description) ),",
				"          severity = iif(     isNull(severity) || trim(severity) == '',     toString(null()),     iif(         upper(trim(severity)) == 'MILD',         'Mild',         iif(             upper(trim(severity)) == 'MODERATE',             'Moderate',             iif(                 upper(trim(severity)) == 'SEVERE',                 'Severe',                 iif(                     upper(trim(severity)) == 'CRITICAL',                     'Critical',                     toString(null())                 )             )         )     ) )) ~> derivedColumn1",
