{
	"name": "gold_fact_facturacion_df",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_fact_facturacion",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    b.billing_id AS billing_id_bk,\\n    b.admission_id AS admission_id_bk,\\n    p.paciente_key,\\n    dep.departamento_key,\\n    sc.servicio_cargo_key,\\n    CASE\\n        WHEN b.payment_date IS NOT NULL\\n        THEN CAST(CONVERT(VARCHAR(8), b.payment_date, 112) AS INT)\\n        ELSE NULL\\n    END AS fecha_pago_key,\\n    b.amount AS monto_facturado,\\n    1 AS conteo_transacciones\\nFROM silver.billing b\\nINNER JOIN silver.admissions a\\n    ON b.admission_id = a.admission_id\\nINNER JOIN gold.dim_paciente p\\n    ON a.patient_id = p.patient_id_bk\\nINNER JOIN gold.dim_departamento dep\\n    ON a.department = dep.nombre_departamento\\nINNER JOIN gold.dim_servicio_cargo sc\\n    ON b.charge_type = sc.tipo_cargo\\n   AND b.payment_status = sc.estado_pago;',",
				"     format: 'query') ~> source1",
				"source1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          facturacion_key as long,",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}